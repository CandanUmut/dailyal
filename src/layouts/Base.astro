---
import '../styles/global.css';
import { palettes } from '../styles/palettes.mjs';
import { APP } from '../config';
import { u } from '../lib/url';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';

interface Props { title?: string; tab?: 'today' | 'words' | 'listen' | 'surahs' | 'library' | 'settings'; description?: string }
const { title, tab, description = APP.description } = Astro.props;
const full = title ? `${title} · ${APP.name}` : `${APP.name} · ${APP.tagline}`;
const vars = (p: Record<string, string>) => Object.entries(p).map(([k, v]) => `--${k}:${v}`).join(';');
const tokens = `:root{${vars(palettes.light)};color-scheme:light}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){${vars(palettes.dark)};color-scheme:dark}}:root[data-theme="dark"]{${vars(palettes.dark)};color-scheme:dark}`;
const tabs = [['today', 'Today', 'Bugün', ''], ['words', 'Words', 'Kelimeler', 'words/'], ['listen', 'Listen', 'Dinle', 'listen/'], ['surahs', 'Surahs', 'Sureler', 'surahs/'], ['library', 'Library', 'Kitaplık', 'library/']] as const;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{full}</title>
<meta name="description" content={description}>
<meta name="theme-color" content={palettes.light.paper} media="(prefers-color-scheme: light)">
<meta name="theme-color" content={palettes.dark.paper} media="(prefers-color-scheme: dark)">
<link rel="manifest" href={u('manifest.webmanifest')}>
<link rel="icon" href={u('icons/icon.svg')} type="image/svg+xml">
<link rel="apple-touch-icon" href={u('icons/apple-touch-icon.png')}>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content={APP.name}>
<style is:inline set:html={tokens}></style>
<script is:inline>try{var s=(JSON.parse(localStorage.getItem("fahm-v1")||"{}").set||{});if(s.theme==="light"||s.theme==="dark")document.documentElement.dataset.theme=s.theme;var l=s.lang==="tr"||s.lang==="en"?s.lang:((navigator.language||"").toLowerCase().indexOf("tr")===0?"tr":"en");document.documentElement.lang=l;}catch(e){}</script>
</head>
<body data-base={u()}>
<a href="#main" style="position:absolute;left:-999px"><T en="Skip to content" tr="İçeriğe geç" /></a>
<header class="top"><div class="wrap">
  <a class="mark" href={u()} aria-label={`${APP.name}, today`}><b>{APP.name}</b><span class="ar" style="font-size:18px">{APP.ar}</span></a>
  <a class="ib" href={u('settings/')} aria-label="Settings" aria-current={tab === 'settings' ? 'page' : undefined}><Icon name="settings" /></a>
</div></header>
<main id="main" class="wrap"><slot /></main>
<nav class="nav" aria-label="Sections"><ul>
  {tabs.map(([id, en, tr, path]) => (
    <li><a href={u(path)} aria-current={tab === id ? 'page' : undefined} data-tab={id}><Icon name={id} /><T en={en} tr={tr} /></a></li>
  ))}
</ul></nav>
<script>
  import { badge } from '../scripts/chrome';
  badge();
  if ('serviceWorker' in navigator && location.hostname !== 'localhost') navigator.serviceWorker.register(document.body.dataset.base + 'sw.js').catch(() => {});
</script>
</body>
</html>
